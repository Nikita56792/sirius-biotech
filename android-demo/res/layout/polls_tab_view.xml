<?xml version="1.0" encoding="utf-8"?>
<merge android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent">
        <FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent" style="@style/Widget.Eventicious.ContentCard">
            <androidx.recyclerview.widget.RecyclerView android:id="@android:id/list" android:clipToPadding="false" android:layout_width="fill_parent" android:layout_height="fill_parent" android:alpha="0.0" />
            <include android:id="@android:id/empty" android:visibility="gone" layout="@layout/empty_layout" />
            <include android:id="@id/error" android:visibility="gone" layout="@layout/error_layout" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_gravity="center" android:id="@android:id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminate="true" />
        </FrameLayout>
    </FrameLayout>
</merge>
