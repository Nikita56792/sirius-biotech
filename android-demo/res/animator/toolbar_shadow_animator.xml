<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <objectAnimator android:duration="150" android:valueFrom="0" android:valueTo="0.1" android:valueType="floatType" android:propertyName="alpha" />
    </item>
    <item>
        <objectAnimator android:duration="50" android:valueFrom="0.1" android:valueTo="0" android:valueType="floatType" android:propertyName="alpha" />
    </item>
</selector>
